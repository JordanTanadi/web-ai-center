# Salin ke `.env` lokal di folder server/ (di-gitignore, jangan commit).
# Semua nilai di sini DUMMY — jangan pernah menaruh kredensial asli di sini.

# Port HTTP backend. Default: 3000 (cocok dengan VITE_API_BASE_URL frontend).
PORT=3000

# Koneksi PostgreSQL asli. ISI DUMMY — ganti di .env lokal.
# Bila kosong/tidak di-set, backend otomatis memakai PGlite (Postgres in-process)
# di folder server/.pglite untuk development tanpa instalasi server DB.
DATABASE_URL=postgres://user:password@localhost:5432/ai_center

# Origin frontend yang diizinkan (CORS), dipisah koma.
CORS_ORIGIN=http://localhost:5173

# Password admin login sederhana (dashboard /admin — POST /api/admin/login).
# DUMMY — ganti dengan password Anda di .env lokal (jangan commit).
# Bila kosong/tidak di-set, backend memakai fallback 'admin-dev' + mencetak peringatan.
ADMIN_PASSWORD=ganti-dengan-password-admin-lokal

# Folder penyimpanan file unggahan admin (POST /api/admin/upload → GET /uploads/:nama).
# Default bila tidak di-set: <cwd>/uploads (di-gitignore).
# Di produksi arahkan ke folder persistent di luar repo, mis.:
# UPLOAD_DIR=/var/www/ai-center/uploads
# (agar file gambar tidak hilang saat deploy ulang; folder harus writable.)
UPLOAD_DIR=./uploads
